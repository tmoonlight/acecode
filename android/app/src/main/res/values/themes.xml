<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ACECode.Base" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">@color/ace_bg</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorAccent">@color/ace_accent</item>
        <item name="android:textColorPrimary">@color/ace_fg</item>
        <item name="android:textColorSecondary">@color/ace_fg_muted</item>
        <item name="android:statusBarColor">@color/ace_bg</item>
        <item name="android:navigationBarColor">@color/ace_bg</item>
        <item name="android:windowLightStatusBar">@bool/ace_light_bars</item>
    </style>
    <style name="Theme.ACECode" parent="Theme.ACECode.Base" />
    <style name="Widget.ACECode.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ace_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/ace_fg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.ACECode.Button.Primary" parent="Widget.ACECode.Button">
        <item name="android:background">@drawable/ace_button_primary</item>
        <item name="android:textColor">@color/ace_on_accent</item>
    </style>
</resources>
