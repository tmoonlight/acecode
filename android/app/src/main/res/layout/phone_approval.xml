<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/ace_card_padding"
    android:background="@drawable/ace_card">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fillViewport="false">
        <TextView
            android:id="@+id/approval_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/ace_fg" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <Button
            android:id="@+id/approval_deny"
            style="@style/Widget.ACECode.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/phone_deny" />
        <Button
            android:id="@+id/approval_allow"
            style="@style/Widget.ACECode.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/ace_button_gap"
            android:minWidth="0dp"
            android:text="@string/phone_allow_once" />
    </LinearLayout>
</LinearLayout>
